COMPOSE_PROJECT_NAME=aegisquant

# Local-only development credentials. Replace these values outside local development.
POSTGRES_DB=aegisquant
POSTGRES_USER=aegisquant
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

API_PORT=8000
AEGISQUANT_ENV=dev

# Optional Stage 1 overrides. Source data remains outside Git under this directory.
AEGISQUANT_RAW_DATA_DIR=data/raw
AEGISQUANT_INGESTION_REQUEST_TIMEOUT_SECONDS=30
AEGISQUANT_INGESTION_MAX_ATTEMPTS=3

# Optional validation-only provider. Never used for canonical ingestion.
# ALPHAVANTAGE_API_KEY=
